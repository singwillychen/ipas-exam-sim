# 複製成 .env.local 後填入（.env.local 已被 .gitignore 排除）
# 前端用的公開值（也寫在 assets/js/config.js）
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon or publishable key>

# scripts/import_questions.sh 用的管理員帳號（profiles.is_admin = true）
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- 以下「不要」放在這裡，請設定在 Supabase → Edge Functions → Secrets ----
# MINIMAX_API_KEY=        老師對話用的 MiniMax 金鑰（只能存在伺服器端）
# MINIMAX_MODEL=MiniMax-M2.7
# MINIMAX_BASE_URL=https://api.minimax.io/v1
